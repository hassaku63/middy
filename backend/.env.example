# The environment variables the server reads (internal/config). Nothing reads
# this file: pass the values in the environment when you start the server,
# e.g. `LLM_PROVIDER=anthropic ANTHROPIC_API_KEY=... make up` (ADR-0011).
# Every value is optional; the server starts with no environment at all.

# HTTP listen port
PORT=8080

# "fake" (default, no network) or "anthropic" (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=fake

# Only read when LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-opus-5-5
