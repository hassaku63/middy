# Copy to backend/.env for local use (never commit .env). `make dev-backend`
# and `docker compose` (compose.yaml) both read it.
# Every value is optional; the server starts with no environment at all.

# HTTP listen port
PORT=8080

# "fake" (default, no network) or "anthropic" (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=fake

# Only read when LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-opus-5-5
