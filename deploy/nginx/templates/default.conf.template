# The web container (ADR-0027): serves the built SPA and passes /api to the
# Go container on the same origin. The nginx image renders this template
# into conf.d at start, filling ${PORT} and ${API_UPSTREAM} (a URL such as
# http://api:8081, the same name and form the Vite dev server reads) from
# the environment (ADR-0011). The serving rules are ADR-0022's; scripts/smoke.sh
# checks them against any running stack.

# Keep the scheme a TLS-terminating proxy in front saw; nginx's own is http.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT};
    server_tokens off;
    root /usr/share/nginx/html;

    # Resolve API_UPSTREAM per request (cached 10 s), so a recreated api
    # container's new address is picked up. RESOLVER is the network's DNS
    # (127.0.0.11 under compose); an IP upstream never asks it.
    resolver ${RESOLVER} valid=10s ipv6=off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # nginx's own liveness, for the container and a load balancer.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API, unchanged. The read timeout outlives the Go server's
    # WriteTimeout (150 s, backend/cmd/server/main.go), and the body limit
    # admits the MIDI export's 4 MiB (backend/internal/httpapi/export.go).
    location ~ ^/api(/|$) {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        client_max_body_size 4m;
        # What nginx answers here in the API's place is a problem detail like
        # the API's own (RFC 9457, ADR-0030; docs/api/problems.md). Errors
        # the API returns pass through untouched.
        error_page 413 = @api_request_too_large;
        error_page 502 503 504 = @api_unavailable;
    }

    # Hashed build output: cached for a year. A missing one is a 404, and so
    # is the directory itself (a file path, never index.html).
    location = /assets {
        return 404;
    }
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The web app manifest, with its own type: not every mime.types has it.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Any other path that names a file (it has an extension): served as it
    # is and revalidated, or a 404, never index.html.
    location ~ \.[A-Za-z0-9]+$ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Screen URLs: the app shell, revalidated so a deploy is picked up.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    # Errors for the app's files and screens are short plain text, never an
    # HTML page (ADR-0033): they are not API responses, so not problem
    # details. The static module may already have typed the answer; an
    # empty type map makes default_type apply.
    error_page 404 = @not_found;
    error_page 405 = @method_not_allowed;
    error_page 413 = @request_too_large;
    location @not_found {
        types { }
        default_type text/plain;
        add_header Cache-Control "no-cache" always;
        return 404 "not found\n";
    }
    location @method_not_allowed {
        types { }
        default_type text/plain;
        add_header Allow "GET, HEAD" always;
        return 405 "method not allowed\n";
    }
    location @request_too_large {
        types { }
        default_type text/plain;
        return 413 "request too large\n";
    }
    location @api_request_too_large {
        types { }
        default_type application/problem+json;
        return 413 '{"type":"https://github.com/hassaku63/middy/blob/main/docs/api/problems.md#request_too_large","title":"Request too large","status":413,"detail":"the request body is larger than 4 MiB","code":"request_too_large"}\n';
    }
    location @api_unavailable {
        types { }
        default_type application/problem+json;
        return 503 '{"type":"https://github.com/hassaku63/middy/blob/main/docs/api/problems.md#api_unavailable","title":"API unavailable","status":503,"detail":"the API is not reachable; try again","code":"api_unavailable"}\n';
    }
}
